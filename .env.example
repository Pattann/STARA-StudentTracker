# ============================================================
# DATABASE CONFIGURATION (Server-Only — Never Exposed to Client)
# ============================================================
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (Supabase PostgreSQL on Vercel):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================
# AUTH & SESSION SECRET (Server-Only)
# ============================================================
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"
DEMO_SESSION_EXPIRY_HOURS=24
HEALTH_CHECK_TOKEN="set-a-secret-token-for-database-health-check"

# ============================================================
# AI PROVIDER CONFIGURATION (Server-Only)
# ============================================================
# Falls back to deterministic academic rules engine if unset
AI_PROVIDER="google"
GOOGLE_AI_API_KEY=""
