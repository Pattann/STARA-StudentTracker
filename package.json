{
  "name": "stara",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node scripts/prepare-db.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node scripts/prepare-db.mjs",
    "db:push": "node scripts/prepare-db.mjs && npx prisma db push",
    "db:migrate": "node scripts/prepare-db.mjs && npx prisma migrate dev",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^5.22.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
